---
import '@fontsource-variable/saira/standard.css';
import '../styles/global.css';

const title = 'Volt Estúdio Criativo | Sites e landing pages';
const description =
  'Criação de landing pages, sites institucionais e manutenção com design estratégico. Conheça os projetos da Volt Estúdio Criativo, criada por Matheus Felipe.';
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : null;
const ogImage = Astro.site ? new URL('/og.png', Astro.site).href : null;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101114" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Volt Estúdio Criativo" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Decide antes da primeira pintura, para o layout fixado por rolagem não pular depois.
      if (
        !matchMedia('(prefers-reduced-motion: reduce)').matches &&
        document.createElement('canvas').getContext('webgl2')
      ) {
        document.documentElement.classList.add('has-3d');
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>
    <slot />
  </body>
</html>
