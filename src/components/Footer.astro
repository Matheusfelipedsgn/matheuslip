---
import Wordmark from '../assets/logo/volt-wordmark.svg';
import { contact, emailUrl, gmailUrl, instagramUrl, nav, whatsappUrl } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap grid">
    <div class="signature">
      <Wordmark class="wordmark" role="img" aria-label="Volt" />
      <p class="name">Estúdio Criativo</p>
    </div>

    <nav aria-label="Rodapé">
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><a href="#contato">Contato</a></li>
      </ul>
    </nav>

    <ul class="contacts">
      <li><a href={instagramUrl} target="_blank" rel="noopener">Instagram</a></li>
      {whatsappUrl && <li><a href={whatsappUrl} target="_blank" rel="noopener">WhatsApp</a></li>}
      <li><a href={contact.behance} target="_blank" rel="noopener">Behance</a></li>
      <li><a href={emailUrl} data-email data-gmail={gmailUrl}>{contact.email}</a></li>
    </ul>

    <p class="copyright">© {year} Volt Estúdio Criativo. Todos os direitos reservados.</p>
  </div>
</footer>

<style>
  .footer {
    --logo-accent: var(--accent);
    padding-block: clamp(3rem, 6vw, 5rem) 2rem;
    background: var(--ink);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 2.5rem clamp(1rem, 2vw, 2rem);
  }

  .signature {
    grid-column: 1 / span 6;
  }

  .wordmark {
    width: clamp(10rem, 18vw, 16rem);
    height: auto;
  }

  .name {
    margin-top: 0.625rem;
    color: var(--muted-on-ink);
    letter-spacing: 0.04em;
  }

  nav {
    grid-column: 7 / span 2;
  }

  .contacts {
    grid-column: 9 / -1;
  }

  li a {
    display: inline-block;
    padding-block: 0.3rem;
    overflow-wrap: anywhere;
    text-decoration: underline transparent 2px;
    text-underline-offset: 0.3em;
    transition: text-decoration-color 0.15s linear;
  }

  li a:hover,
  li a:focus-visible {
    text-decoration-color: currentColor;
  }

  .copyright {
    grid-column: 1 / -1;
    color: var(--muted-on-ink);
    font-size: 0.875rem;
  }

  @media (max-width: 56.24rem) {
    .signature,
    .copyright {
      grid-column: 1 / -1;
    }

    nav,
    .contacts {
      grid-column: 1 / -1;
    }
  }
</style>
