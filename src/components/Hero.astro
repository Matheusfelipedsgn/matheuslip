---
import Symbol from '../assets/logo/volt-symbol.svg';
---

<div id="top" class="intro" data-track="hero" aria-hidden="true">
  <div class="stage" data-stage>
    <Symbol class="fallback" />
    <p class="hint" data-hint>Role para entrar</p>
    <div class="flash" data-flash></div>
  </div>
</div>

<style>
  /* A cena de abertura só existe com 3D; sem ele, a página começa direto no título. */
  .intro {
    display: none;
  }

  :global(.has-3d) .intro {
    display: block;
    height: 280svh;
  }

  .stage {
    position: sticky;
    top: 0;
    overflow: clip;
    height: 100svh;
  }

  /* Cobre a tela com o lime exato da marca quando a câmera termina de atravessar o traço. */
  .flash {
    position: absolute;
    background: var(--accent);
    inset: 0;
    opacity: 0;
    pointer-events: none;
  }

  /* Símbolo plano enquanto o 3D carrega. */
  .fallback {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(62vw, 34vh);
    height: auto;
    color: var(--accent);
    transform: translate(-50%, -50%);
  }

  :global(.is-ready) .fallback {
    display: none;
  }

  .hint {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    color: var(--muted-on-ink);
    font-size: 0.9375rem;
    transform: translateX(-50%);
    white-space: nowrap;
  }
</style>
