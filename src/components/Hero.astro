---
import Symbol from '../assets/logo/volt-symbol.svg';
---

<section id="top" class="hero" aria-labelledby="hero-title" data-track="hero">
  <span id="inicio" class="anchor"></span>
  <div class="stage" data-stage>
    <Symbol class="fallback" aria-hidden="true" />
    <p class="hint" aria-hidden="true" data-hint>Role para entrar</p>
    <div class="flash" aria-hidden="true" data-flash></div>

    <div class="wrap content">
      <div data-first>
        <p class="name">Volt Estúdio Criativo</p>
        <h1 id="hero-title">Sites que mostram o valor do seu negócio antes da primeira conversa.</h1>
      </div>
      <div class="closing" data-second>
        <p class="lead">
          Criamos landing pages e sites institucionais para empresas, startups e pequenos comércios,
          do B2B ao B2C.
        </p>
        <div class="actions">
          <a class="button" href="#contato">Vamos conversar</a>
          <a class="text-link" href="#projetos">Conheça nosso trabalho</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
  }

  /* O menu e a logo levam para o fim da cena, com as frases já visíveis. */
  .anchor {
    position: absolute;
    top: 0;
  }

  :global(.has-3d) .hero {
    height: 380svh;
  }

  :global(.has-3d) .anchor {
    top: calc(100% - 100svh);
  }

  .stage {
    position: relative;
    display: grid;
    align-items: center;
    overflow: clip;
    min-height: 100svh;
    padding-block: calc(var(--header-h) + 1rem) 1.5rem;
  }

  :global(.has-3d) .stage {
    position: sticky;
    top: 0;
    height: 100svh;
  }

  /* Na cena de abertura, as frases só nascem depois que o símbolo sai da tela. */
  :global(.has-3d) [data-first],
  :global(.has-3d) [data-second] {
    visibility: hidden;
    opacity: 0;
  }

  /* Símbolo plano enquanto o 3D carrega. */
  .fallback {
    position: absolute;
    top: 50%;
    left: 50%;
    display: none;
    width: min(62vw, 34vh);
    height: auto;
    color: var(--accent);
    transform: translate(-50%, -50%);
  }

  :global(.has-3d) .fallback {
    display: block;
  }

  :global(.is-ready) .fallback {
    display: none;
  }

  .hint {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    display: none;
    color: var(--muted-on-ink);
    font-size: 0.9375rem;
    transform: translateX(-50%);
    white-space: nowrap;
  }

  :global(.has-3d) .hint {
    display: block;
  }

  /* Lime exato da marca: cobre a tela no fim do zoom e abre em diagonal. */
  .flash {
    position: absolute;
    display: none;
    background: var(--accent);
    inset: 0;
    opacity: 0;
    pointer-events: none;
  }

  :global(.has-3d) .flash {
    display: block;
  }

  .content {
    position: relative;
    width: 100%;
    text-align: center;
  }

  .name {
    margin-bottom: 1rem;
    color: var(--accent);
    font-weight: 600;
  }

  h1 {
    max-width: 17ch;
    margin-inline: auto;
    font-size: clamp(2.25rem, min(6.6vw, 11.5vh), 7.5rem);
    letter-spacing: -0.025em;
    line-height: 0.98;
  }

  .closing {
    display: grid;
    justify-items: center;
    gap: 1.5rem;
    margin-top: clamp(1.5rem, 4vh, 3rem);
  }

  .lead {
    max-width: 38rem;
    color: var(--muted-on-ink);
    font-size: clamp(1rem, 1.3vw, 1.25rem);
    line-height: 1.45;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem 1.75rem;
  }
</style>
