---
import { Image } from 'astro:assets';
import { contact, projects } from '../data/site';

// A segunda faixa repete a primeira para o carrossel fechar o ciclo sem emenda.
const tracks = [false, true];
---

<section id="projetos" class="section on-ink" aria-labelledby="projetos-title">
  <div class="wrap head reveal">
    <h2 id="projetos-title">Projetos</h2>
    <a class="text-link" href={contact.behance} target="_blank" rel="noopener">
      Ver portfólio completo no Behance
    </a>
  </div>

  <div class="marquee reveal">
    {
      tracks.map((duplicate) => (
        <ul class:list={['track', { duplicate }]} aria-hidden={duplicate ? 'true' : undefined}>
          {projects.map((project) => (
            <li class="item">
              <a
                class="card"
                href={project.url}
                target="_blank"
                rel="noopener"
                tabindex={duplicate ? -1 : undefined}
              >
                <span class="frame">
                  <Image
                    class="shot"
                    src={project.image}
                    alt={duplicate ? '' : project.alt}
                    widths={[420, 640, 808]}
                    sizes="(min-width: 56.25rem) 30vw, 78vw"
                  />
                </span>
                <span class="name">{project.name}</span>
                <span class="category">{project.category}</span>
              </a>
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</section>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }

  .marquee {
    --gap: clamp(1rem, 2vw, 2rem);
    display: flex;
    overflow-x: auto;
    padding-bottom: 0.5rem;
    scrollbar-width: none;
  }

  .track {
    display: flex;
    flex-shrink: 0;
    gap: var(--gap);
    padding-right: var(--gap);
  }

  /* Sem animação (movimento reduzido), a faixa vira uma lista que se rola com o dedo. */
  .duplicate {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .marquee {
      overflow-x: clip;
    }

    .duplicate {
      display: flex;
    }

    .track {
      animation: marquee 70s linear infinite;
    }

    /* Para enquanto a pessoa aponta para um card ou navega por ele com o teclado. */
    .marquee:hover .track,
    .marquee:focus-within .track {
      animation-play-state: paused;
    }
  }

  @keyframes marquee {
    to {
      transform: translateX(-100%);
    }
  }

  .item {
    width: clamp(16.5rem, 30vw, 30rem);
  }

  .card {
    display: block;
    text-decoration: none;
  }

  .frame {
    display: block;
    overflow: hidden;
    aspect-ratio: 808 / 632;
    border-radius: var(--radius);
    background: var(--line-on-ink);
  }

  .frame :global(.shot) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }

  .name {
    display: block;
    margin-top: 1rem;
    font-size: clamp(1.25rem, 1.8vw, 1.75rem);
    font-stretch: 118%;
    font-weight: 700;
    line-height: 1.15;
    transition: color 0.15s linear;
  }

  .category {
    display: block;
    margin-top: 0.125rem;
    color: var(--muted-on-ink);
  }

  @media (hover: hover) {
    .card:hover .frame :global(.shot) {
      transform: scale(1.04);
    }

    .card:hover .name {
      color: var(--accent);
    }
  }
</style>
