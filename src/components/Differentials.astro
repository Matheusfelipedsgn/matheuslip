---
import { differentials } from '../data/site';
---

<section class="section on-paper" aria-labelledby="diferenciais-title" data-light>
  <div class="wrap grid">
    <h2 id="diferenciais-title" class="reveal">O que guia cada projeto</h2>

    <ul class="list">
      {
        differentials.map((item) => (
          <li class="reveal">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2vw, 2rem);
  }

  h2 {
    position: sticky;
    top: calc(var(--header-h) + 3rem);
    grid-column: 1 / span 5;
    align-self: start;
  }

  .list {
    grid-column: 7 / -1;
    display: grid;
    gap: clamp(1.75rem, 3vw, 2.75rem);
  }

  h3 {
    font-size: clamp(1.375rem, 2.3vw, 2.125rem);
    font-stretch: 112%;
    font-weight: 600;
    line-height: 1.15;
  }

  p {
    margin-top: 0.375rem;
    color: var(--muted-on-paper);
  }

  @media (max-width: 56.24rem) {
    h2,
    .list {
      grid-column: 1 / -1;
    }

    h2 {
      position: static;
    }

    .list {
      margin-top: 2.5rem;
    }
  }
</style>
