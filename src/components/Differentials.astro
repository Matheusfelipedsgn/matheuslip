---
import { differentials } from '../data/site';
---

<section class="section on-paper t-in t-out" aria-labelledby="diferenciais-title" data-light>
  <div class="wrap">
    <h2 id="diferenciais-title" class="reveal">O que guia cada projeto</h2>

    <ul class="list">
      {
        differentials.map((item) => (
          <li class="row reveal">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  h2 {
    max-width: 12ch;
    font-size: clamp(2.25rem, 6.4vw, 7rem);
    letter-spacing: -0.02em;
  }

  .list {
    margin-top: clamp(2.5rem, 6vw, 5rem);
  }

  .row {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    align-items: baseline;
    gap: 0.375rem clamp(1rem, 4vw, 4rem);
    padding-block: clamp(1rem, 1.8vw, 1.75rem);
    border-top: 2px solid var(--ink);
  }

  h3 {
    font-size: clamp(1.5rem, 3.4vw, 3.5rem);
    font-stretch: 116%;
    font-weight: 700;
    letter-spacing: -0.012em;
    line-height: 1.06;
  }

  p {
    color: var(--muted-on-paper);
  }

  @media (max-width: 56.24rem) {
    .row {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
