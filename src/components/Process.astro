---
import { steps } from '../data/site';
---

<section id="processo" class="process on-black" aria-labelledby="processo-title" data-track="process">
  <div class="stage" data-stage>
    <div class="column" data-column>
      <h2 id="processo-title">Como funciona um projeto</h2>

      <ol class="steps">
        {
          steps.map((step, index) => (
            <li class:list={['step', { 'is-active': index === 0 }]} data-item>
              <span class="number" aria-hidden="true">{index + 1}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .stage {
    padding: var(--section) var(--edge);
  }

  h2 {
    font-size: clamp(2.125rem, 5.4vw, 4.75rem);
  }

  .steps {
    margin-top: clamp(2rem, 4vw, 3.5rem);
  }

  .step {
    display: grid;
    grid-template-columns: clamp(3rem, 6vw, 5.5rem) minmax(0, 1fr);
    align-items: start;
    padding-block: clamp(1.25rem, 2.2vw, 2rem);
    border-top: 2px solid var(--line-on-ink);
  }

  .number {
    font-size: clamp(2.25rem, 4vw, 3.75rem);
    font-stretch: 118%;
    font-weight: 700;
    line-height: 0.95;
  }

  h3 {
    font-size: clamp(1.25rem, 1.9vw, 1.75rem);
    font-stretch: 112%;
    font-weight: 700;
    line-height: 1.2;
  }

  p {
    max-width: 32rem;
    margin-top: 0.375rem;
    color: var(--muted-on-ink);
  }

  /* Com 3D: o objeto se monta no centro e as etapas acompanham em quatro colunas na base. */
  :global(.has-3d) .process {
    height: 320svh;
  }

  @media (pointer: coarse) {
    :global(.has-3d) .process {
      height: 450svh;
    }
  }

  :global(.has-3d) .stage {
    position: sticky;
    top: 0;
    overflow: clip;
    height: 100svh;
    min-height: 38rem;
    padding: 0;
  }

  :global(.has-3d) .column {
    position: absolute;
    right: 0;
    bottom: clamp(1.5rem, 4vh, 3rem);
    left: 0;
    padding-inline: var(--edge);
  }

  :global(.has-3d) h2 {
    font-size: clamp(1.75rem, 3vw, 3.25rem);
  }

  :global(.has-3d) .steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 2rem);
    margin-top: 1.5rem;
  }

  :global(.has-3d) .step {
    display: block;
    padding-block: 1rem 0;
    transition: border-color 0.3s linear;
  }

  :global(.has-3d) .number,
  :global(.has-3d) h3,
  :global(.has-3d) p {
    color: var(--dim-on-ink);
    transition: color 0.3s linear;
  }

  :global(.has-3d) .number {
    display: block;
    margin-bottom: 0.5rem;
  }

  :global(.has-3d) .is-active {
    border-color: var(--accent);
  }

  :global(.has-3d) .is-active .number {
    color: var(--accent);
  }

  :global(.has-3d) .is-active h3 {
    color: var(--paper);
  }

  :global(.has-3d) .is-active p {
    color: var(--muted-on-ink);
  }

  @media (max-width: 56.24rem) {
    :global(.has-3d) .column {
      bottom: 1rem;
      padding-inline: var(--gutter);
    }

    :global(.has-3d) h2 {
      font-size: clamp(1.5rem, 6.4vw, 2.75rem);
    }

    :global(.has-3d) .steps {
      display: block;
      margin-top: 0.75rem;
    }

    :global(.has-3d) .step {
      display: grid;
      grid-template-columns: 2.25rem minmax(0, 1fr);
      padding-block: 0.5rem;
    }

    :global(.has-3d) .number {
      margin: 0;
      font-size: 1.625rem;
    }

    :global(.has-3d) h3 {
      font-size: 1.0625rem;
    }

    :global(.has-3d) p {
      margin-top: 0.125rem;
      font-size: 0.875rem;
      line-height: 1.35;
    }
  }
</style>
