---
import Wordmark from '../assets/logo/volt-wordmark.svg';
import { nav } from '../data/site';
---

<header class="header is-intro">
  <div class="wrap bar">
    <a class="brand" href="#inicio" aria-label="Volt Estúdio Criativo, início">
      <Wordmark class="logo" aria-hidden="true" />
    </a>

    <button
      class="toggle"
      type="button"
      aria-expanded="false"
      aria-controls="menu"
      data-menu-toggle
    >
      <span data-menu-label>Menu</span>
    </button>

    <nav id="menu" class="menu" aria-label="Principal" data-menu>
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><a class="contact" href="#contato">Vamos conversar</a></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const label = document.querySelector<HTMLElement>('[data-menu-label]')!;
  const menu = document.querySelector<HTMLElement>('[data-menu]')!;

  const setOpen = (open: boolean) => {
    toggle.setAttribute('aria-expanded', String(open));
    label.textContent = open ? 'Fechar' : 'Menu';
    menu.toggleAttribute('data-open', open);
    document.documentElement.style.overflow = open ? 'hidden' : '';
  };

  toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  menu.addEventListener('click', (event) => {
    if ((event.target as Element).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });
  matchMedia('(min-width: 56.25rem)').addEventListener('change', () => setOpen(false));

  // A barra troca de tom quando uma seção clara passa pela faixa que ela ocupa.
  const header = document.querySelector('header')!;
  const under = new Set<Element>();
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) under.add(entry.target);
        else under.delete(entry.target);
      }
      header.classList.toggle('is-light', under.size > 0);
    },
    // A margem superior evita contar como "embaixo da barra" uma seção que só encosta no topo.
    { rootMargin: '-1px 0px -96% 0px' },
  );
  document.querySelectorAll('[data-light]').forEach((section) => observer.observe(section));
</script>

<style>
  .header {
    position: fixed;
    z-index: 20;
    top: 0.75rem;
    right: var(--gutter);
    left: var(--gutter);
    max-width: 100rem;
    margin-inline: auto;
    transition:
      color 0.2s linear,
      opacity 0.35s linear,
      visibility 0.35s linear;
  }

  /* Na cena de abertura só existe o símbolo; a barra entra junto com o site. */
  :global(.has-3d) .header.is-intro {
    visibility: hidden;
    opacity: 0;
  }

  .header {
    --logo-accent: var(--accent);
  }

  .header.is-light,
  .header.is-flash {
    --logo-accent: var(--ink);
    color: var(--ink);
  }

  /* O vidro fica no pseudo-elemento: backdrop-filter no próprio header prenderia o menu mobile,
     que é fixo, dentro da barra. O tom escuro mantém o texto legível sobre seções claras. */
  .header::before {
    position: absolute;
    z-index: -1;
    background: rgb(0 0 0 / 0.94);
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px rgb(244 243 239 / 0.14);
    content: '';
    inset: 0;
  }

  @supports (backdrop-filter: blur(1px)) {
    .header::before {
      background: rgb(0 0 0 / 0.55);
      backdrop-filter: blur(24px) saturate(180%);
      transition: background-color 0.2s linear;
    }

    /* Sobre seções claras o vidro também clareia, em vez de virar um cinza pesado. */
    .header.is-light::before,
    .header.is-flash::before {
      background: rgb(244 243 239 / 0.76);
      box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.12);
    }
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 3.5rem;
    padding-inline: 1.25rem 0.5rem;
  }

  .brand {
    display: block;
    padding-block: 0.5rem;
  }

  .logo {
    width: auto;
    height: 1.75rem;
  }

  .toggle {
    min-width: 3rem;
    min-height: 2.75rem;
    padding: 0 0.75rem;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
    font: inherit;
    font-weight: 600;
    text-align: right;
  }

  .menu ul {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .menu a {
    display: block;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 0.15s linear;
  }

  .menu a:hover,
  .menu a:focus-visible {
    background: rgb(128 128 128 / 0.22);
  }

  @media (min-width: 56.25rem) {
    .menu .contact {
      margin-left: 0.5rem;
      background: var(--accent);
      color: var(--on-accent);
      font-weight: 600;
    }

    .menu .contact:hover,
    .menu .contact:focus-visible {
      background: var(--paper);
    }

    .is-light .menu .contact,
    .is-flash .menu .contact {
      background: var(--ink);
      color: var(--paper);
    }
  }

  @media (min-width: 56.25rem) {
    .toggle {
      display: none;
    }
  }

  @media (max-width: 56.24rem) {
    .menu {
      position: fixed;
      z-index: -1;
      inset: 0;
      visibility: hidden;
      padding: calc(var(--header-h) + 2rem) var(--gutter) 2rem;
      background: var(--ink);
      opacity: 0;
      transition:
        opacity 0.18s linear,
        visibility 0.18s linear;
    }

    .menu[data-open] {
      visibility: visible;
      color: var(--paper);
      opacity: 1;
    }

    .menu ul {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }

    .menu a {
      padding-inline: 0;
      font-size: 2rem;
      font-stretch: 118%;
      font-weight: 700;
      line-height: 1.2;
    }

    .menu a:hover,
    .menu a:focus-visible {
      background: none;
      color: var(--accent);
    }

    .menu .contact {
      margin-top: 1.5rem;
      color: var(--accent);
    }
  }
</style>
