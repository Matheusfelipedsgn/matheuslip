---
import Wordmark from '../assets/logo/volt-wordmark.svg';
import { nav } from '../data/site';
---

<header class="header">
  <div class="wrap bar">
    <a class="brand" href="#top" aria-label="Volt Estúdio Criativo, início">
      <Wordmark class="logo" aria-hidden="true" />
    </a>

    <button
      class="toggle"
      type="button"
      aria-expanded="false"
      aria-controls="menu"
      data-menu-toggle
    >
      <span data-menu-label>Menu</span>
    </button>

    <nav id="menu" class="menu" aria-label="Principal" data-menu>
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><a class="contact" href="#contato">Vamos conversar</a></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const label = document.querySelector<HTMLElement>('[data-menu-label]')!;
  const menu = document.querySelector<HTMLElement>('[data-menu]')!;

  const setOpen = (open: boolean) => {
    toggle.setAttribute('aria-expanded', String(open));
    label.textContent = open ? 'Fechar' : 'Menu';
    menu.toggleAttribute('data-open', open);
    document.documentElement.style.overflow = open ? 'hidden' : '';
  };

  toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  menu.addEventListener('click', (event) => {
    if ((event.target as Element).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });
  matchMedia('(min-width: 56.25rem)').addEventListener('change', () => setOpen(false));

  // A barra troca de tom quando uma seção clara passa pela faixa que ela ocupa.
  const header = document.querySelector('header')!;
  const under = new Set<Element>();
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) under.add(entry.target);
        else under.delete(entry.target);
      }
      header.classList.toggle('is-light', under.size > 0);
    },
    { rootMargin: '0px 0px -96% 0px' },
  );
  document.querySelectorAll('[data-light]').forEach((section) => observer.observe(section));
</script>

<style>
  .header {
    position: fixed;
    z-index: 20;
    top: 0;
    right: 0;
    left: 0;
    transition: color 0.2s linear;
  }

  .header.is-light {
    color: var(--ink);
  }

  /* O vidro fica no pseudo-elemento: backdrop-filter no próprio header prenderia o menu mobile,
     que é fixo, dentro da barra. O tom escuro mantém o texto legível sobre seções claras. */
  .header::before {
    position: absolute;
    z-index: -1;
    background: rgb(16 17 20 / 0.94);
    box-shadow:
      inset 0 -1px 0 rgb(244 243 239 / 0.12),
      inset 0 1px 0 rgb(244 243 239 / 0.04);
    content: '';
    inset: 0;
  }

  @supports (backdrop-filter: blur(1px)) {
    .header::before {
      background: rgb(16 17 20 / 0.62);
      backdrop-filter: blur(16px) saturate(170%);
      transition: background-color 0.2s linear;
    }

    /* Sobre seções claras o vidro também clareia, em vez de virar um cinza pesado. */
    .header.is-light::before {
      background: rgb(244 243 239 / 0.58);
      box-shadow: inset 0 -1px 0 rgb(16 17 20 / 0.12);
    }
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
  }

  .brand {
    display: block;
    padding-block: 0.5rem;
  }

  .logo {
    width: auto;
    height: 1.75rem;
  }

  .toggle {
    min-width: 3rem;
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
    font: inherit;
    font-weight: 600;
    text-align: right;
  }

  .menu ul {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 2.5vw, 2.5rem);
  }

  .menu a {
    display: block;
    padding-block: 0.5rem;
    font-weight: 500;
    text-decoration: underline transparent 2px;
    text-underline-offset: 0.35em;
    transition: text-decoration-color 0.15s linear;
  }

  .menu a:hover,
  .menu a:focus-visible {
    text-decoration-color: currentColor;
  }

  @media (min-width: 56.25rem) {
    .toggle {
      display: none;
    }
  }

  @media (max-width: 56.24rem) {
    .menu {
      position: fixed;
      inset: var(--header-h) 0 0;
      visibility: hidden;
      padding: 2rem var(--gutter);
      background: var(--ink);
      opacity: 0;
      transition:
        opacity 0.18s linear,
        visibility 0.18s linear;
    }

    .menu[data-open] {
      visibility: visible;
      color: var(--paper);
      opacity: 1;
    }

    .menu ul {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }

    .menu a {
      font-size: 2rem;
      font-stretch: 118%;
      font-weight: 700;
      line-height: 1.2;
    }

    .menu .contact {
      margin-top: 1.5rem;
      color: var(--paper);
      text-decoration-color: var(--accent);
    }
  }
</style>
