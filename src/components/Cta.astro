---
import { contact, emailUrl, gmailUrl, whatsappUrl } from '../data/site';
---

<section class="cta" aria-labelledby="contato-title" data-track="closing">
  <span id="contato" class="anchor"></span>
  <div class="stage" data-stage>
    <div class="flash" aria-hidden="true" data-flash></div>

    <div class="wrap content" data-closing>
      <h2 id="contato-title">Seu próximo projeto digital começa com uma boa ideia.</h2>
      <div class="closing">
        <p class="lead">Conte o que você precisa. A partir daí, vemos juntos o melhor caminho para o seu site.</p>
        <div class="actions">
          <a
            class="button"
            href={whatsappUrl ?? emailUrl}
            {...whatsappUrl ? { target: '_blank', rel: 'noopener' } : {}}
            data-final-cta
          >
            Solicitar orçamento
          </a>
          <a class="text-link" href={emailUrl} data-email data-gmail={gmailUrl}>{contact.email}</a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // No computador, mailto: não abre nada sem um programa de email configurado. No celular, abre o app.
  if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
    document.querySelectorAll<HTMLAnchorElement>('[data-email]').forEach((link) => {
      link.href = link.dataset.gmail!;
      link.target = '_blank';
      link.rel = 'noopener';
    });
  }
</script>

<style>
  .cta {
    position: relative;
  }

  /* Quem clica em "Vamos conversar" chega direto ao botão, sem passar pela animação. */
  .anchor {
    position: absolute;
    top: 0;
  }

  :global(.has-3d) .anchor {
    top: calc(100% - 100svh);
  }

  /* Sem 3D: seção lime comum, com tudo visível. */
  .stage {
    position: relative;
    display: grid;
    align-content: center;
    padding-block: var(--section);
    background: var(--accent);
    color: var(--on-accent);
    --button-bg: var(--ink);
    --button-fg: var(--paper);
    --button-hover: var(--paper);
    --button-hover-fg: var(--ink);
  }

  .flash {
    display: none;
  }

  /* Com 3D: o símbolo volta inteiro, a câmera entra nele e o lime toma a tela. */
  :global(.has-3d) .cta {
    height: 300svh;
  }

  :global(.has-3d) .stage {
    position: sticky;
    top: 0;
    overflow: clip;
    height: 100svh;
    min-height: 38rem;
    padding-block: var(--header-h) 1.5rem;
    background: none;
  }

  :global(.has-3d) .flash {
    position: absolute;
    display: block;
    background: var(--accent);
    inset: 0;
    opacity: 0;
    pointer-events: none;
  }

  :global(.has-3d) .content {
    visibility: hidden;
    opacity: 0;
  }

  .content {
    position: relative;
    width: 100%;
  }

  h2 {
    max-width: 17ch;
    font-size: clamp(2.25rem, min(7.2vw, 13vh), 7.5rem);
    letter-spacing: -0.02em;
  }

  .closing {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: end;
    column-gap: clamp(1rem, 2vw, 2rem);
    margin-top: clamp(2rem, 5vw, 4.5rem);
  }

  .lead {
    grid-column: 1 / span 5;
    font-size: clamp(1.0625rem, 1.3vw, 1.25rem);
  }

  .actions {
    grid-column: 7 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
  }

  .text-link {
    overflow-wrap: anywhere;
  }

  @media (max-width: 56.24rem) {
    .lead,
    .actions {
      grid-column: 1 / -1;
    }

    .actions {
      margin-top: 1.5rem;
    }
  }
</style>
