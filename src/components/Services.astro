---
import { services } from '../data/site';

const total = String(services.length).padStart(2, '0');
---

<section id="servicos" class="services on-black" aria-labelledby="servicos-title" data-track="services">
  <div class="stage" data-stage>
    <h2 id="servicos-title">O que a Volt faz</h2>

    <ul class="rail" data-rail-track style={`--count: ${services.length}`}>
      {
        services.map((service, index) => (
          <li class="panel">
            <span class="count" aria-hidden="true">
              {String(index + 1).padStart(2, '0')} / {total}
            </span>
            <h3>{service.name}</h3>
            <p class="description">{service.description}</p>
            <ul class="benefits">
              {service.benefits.map((benefit) => <li>{benefit}</li>)}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Sem 3D: lista corrida, com todo o conteúdo visível. */
  .stage {
    padding: var(--section) var(--edge);
  }

  h2 {
    font-size: clamp(2.125rem, 5.4vw, 4.75rem);
  }

  .panel {
    padding-block: clamp(1.5rem, 3vw, 2.5rem);
    border-top: 2px solid var(--line-on-ink);
  }

  .rail {
    margin-top: 2rem;
  }

  .count {
    color: var(--accent);
    font-weight: 600;
  }

  h3 {
    margin-top: 0.5rem;
    font-size: clamp(1.75rem, 3.6vw, 3.75rem);
    font-stretch: 118%;
    font-weight: 700;
    letter-spacing: -0.012em;
    line-height: 1.04;
    text-wrap: balance;
  }

  .description {
    max-width: 38rem;
    margin-top: 1rem;
  }

  .benefits {
    display: grid;
    gap: 0.375rem;
    margin-top: 1rem;
    color: var(--muted-on-ink);
    font-size: 0.9375rem;
    line-height: 1.4;
  }

  /* Com 3D: a tela fica fixa e os serviços deslizam na horizontal, com o objeto no centro. */
  :global(.has-3d) .services {
    height: 520svh;
  }

  :global(.has-3d) .stage {
    position: sticky;
    top: 0;
    overflow: clip;
    height: 100svh;
    min-height: 38rem;
    padding: 0;
  }

  :global(.has-3d) h2 {
    position: absolute;
    z-index: 1;
    top: calc(var(--header-h) + 1rem);
    right: var(--edge);
    color: var(--muted-on-ink);
    font-size: 1rem;
    font-stretch: 100%;
    font-weight: 500;
    letter-spacing: 0;
    text-align: right;
  }

  :global(.has-3d) .rail {
    display: flex;
    width: calc(var(--count) * 100%);
    height: 100%;
    margin: 0;
    will-change: transform;
  }

  :global(.has-3d) .panel {
    position: relative;
    display: grid;
    flex: 0 0 calc(100% / var(--count));
    grid-template-rows: auto 1fr auto;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 0 clamp(2rem, 30vw, 34rem);
    padding: calc(var(--header-h) + 1rem) var(--edge) clamp(1.5rem, 5vh, 3.5rem);
    border: 0;
  }

  :global(.has-3d) .count {
    grid-column: 1 / -1;
  }

  :global(.has-3d) h3 {
    grid-row: 2;
    grid-column: 1 / -1;
    align-self: start;
    max-width: 14ch;
    font-size: clamp(2.5rem, 6.6vw, 7rem);
  }

  :global(.has-3d) .description {
    grid-row: 3;
    align-self: end;
    margin: 0;
  }

  :global(.has-3d) .benefits {
    grid-row: 3;
    align-self: end;
    justify-self: end;
    margin: 0;
  }

  @media (max-width: 56.24rem) {
    /* Fora da vista no celular, mas ainda presente para leitores de tela. */
    :global(.has-3d) h2 {
      overflow: hidden;
      clip-path: inset(50%);
      width: 1px;
      height: 1px;
      white-space: nowrap;
    }

    :global(.has-3d) .panel {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      padding-inline: var(--gutter);
      padding-bottom: 1.5rem;
    }

    :global(.has-3d) .count {
      font-size: 0.875rem;
    }

    :global(.has-3d) h3 {
      max-width: none;
      margin-top: 0.25rem;
      font-size: clamp(1.75rem, 8vw, 3.25rem);
    }

    :global(.has-3d) .description {
      font-size: 1rem;
      line-height: 1.45;
    }

    :global(.has-3d) .benefits {
      grid-row: 4;
      justify-self: start;
      gap: 0.125rem;
      margin-top: 0.625rem;
      font-size: 0.875rem;
    }
  }
</style>
